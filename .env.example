# Copia este archivo a .env y ajusta los valores. No subas .env al repositorio.
# ASP.NET Core lee las variables con "__" como separador de secciones.
ConnectionStrings__DefaultConnection=Server=localhost;Database=Library;Trusted_Connection=True;TrustServerCertificate=true;
# JWT: la clave es lo único secreto; emisor, audiencia y duración están en appsettings.json. Mínimo 32 caracteres.
Jwt__Key=cambia-esta-clave-por-una-aleatoria-de-al-menos-32-caracteres
